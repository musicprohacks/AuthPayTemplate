# Copy to .env.local and fill in.

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3020

# SQLite file (created automatically). Defaults to ./data/app.db
# DATABASE_PATH=./data/app.db

# Google — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — https://developers.facebook.com/apps (Facebook Login product)
# Valid OAuth Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/facebook
# Note: Facebook can omit email from the profile even with the email permission
# granted — Better Auth then redirects back with ?error=EMAIL_NOT_FOUND
# (handled by OAuthErrorBanner) instead of creating an account.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Resend — https://resend.com/api-keys (used for passwordless email sign-in links)
# Without this set, sign-in links are logged to the server console instead of emailed.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Hello World App <login@musicpro.app>"

# Stripe test mode — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3020/api/webhooks/stripe` (prints a whsec_... value)
STRIPE_WEBHOOK_SECRET=

# Dev-only: lets the email sign-in form skip actually sending mail (avoids
# burning Resend sends while testing). Generate with: openssl rand -hex 32
# Leave unset to disable the bypass entirely. NEVER set this in production.
DEV_BYPASS_KEY=
