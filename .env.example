# Copy to .env.local and fill in.

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# SQLite file (created automatically). Defaults to ./data/app.db
# DATABASE_PATH=./data/app.db

# Google — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — https://resend.com/api-keys (used for passwordless email sign-in links)
# Without this set, sign-in links are logged to the server console instead of emailed.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Hello World App <login@musicpro.app>"
